# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:5174

# ---- Database (PostgreSQL) — REQUIRED, the server does not start meaningfully without it ----
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=25060
DB_DATABASE=defaultdb

# Режим TLS при подключении к БД. Разбор значения — в server/src/dbConfig.js.
#   не задано / require  → шифруем, сертификат не проверяем. Это то, что нужно
#                          для DigitalOcean Managed Postgres (App Platform).
#                          Поведение по умолчанию — как было до появления этой
#                          переменной, менять на проде ничего не требуется.
#   disable              → без TLS. Нужно ровно для одного случая: локальный
#                          Postgres в контейнере рядом на дроплете (deploy/).
#                          Такой сервер отвечает на TLS-хендшейк ошибкой
#                          «The server does not support SSL connections».
DB_SSL=

# Необязательно: строка подключения целиком вместо пяти переменных выше.
# Если задана — DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/DB_DATABASE игнорируются.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Необязательно: PEM корневого сертификата БД. Если задан, цепочка проверяется
# по-настоящему (rejectUnauthorized: true) — самый строгий вариант для managed.
# DB_CA_CERT=

# ---- Telegram notifications ----
# Create a bot via @BotFather, then put the token + your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email notifications (SMTP, optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLICKI <no-reply@clicki.kz>"
MAIL_TO=

# ---- Anti-spam (optional) ----
# Google reCAPTCHA v3 secret key. Leave empty to disable verification.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ---- Admin panel (CMS) ----
# Login for /admin CMS (defaults: admin / admin — change in production!)
ADMIN_USER=admin
ADMIN_PASS=admin
# Break-glass / automation bearer token. A successful /api/admin/login no longer
# hands this to the browser: it mints a random 12h session token instead, so a
# leaked browser token expires and can be revoked by restarting. Keep this secret
# long and random — it never expires.
ADMIN_TOKEN=change-me-please

# ---- Content-Security-Policy ----
# enforce (default) | report-only | off
# The policy allows exactly the third parties the client loads (GA4, Meta Pixel,
# Yandex.Metrika, Google Fonts, reCAPTCHA) and forbids inline <script>. If a new
# third-party tag is added and silently blocked, flip to report-only, watch the
# browser console for violations, add the host in server/src/security.js, then
# switch back to enforce.
CSP_MODE=enforce

# ---- Media storage: DigitalOcean Spaces (recommended for video) ----
# When all four are set, uploads go to Spaces (served via its CDN) and the DB
# never stores video bytes. Leave empty to fall back to DB storage.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1
# Optional overrides:
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# SPACES_CDN=https://<bucket>.fra1.cdn.digitaloceanspaces.com

# ---- AI analysis (Gemini) ----
# Up to 3 keys, rotated to spread quota; results cached 6h to save tokens.
# Leave empty to hide the AI Analytics section in /admin.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# ---- TikTok Login Kit + Display API (auto-sync view counts) ----
# From developers.tiktok.com → Manage apps → your app → Login Kit config.
# Leave empty to disable — creators just won't see the "Connect TikTok" button,
# and view counts stay manual (typed in by the operator, as before).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered for the app in the TikTok
# developer portal. Static, https, no query string (their requirement).
TIKTOK_REDIRECT_URI=https://clicki-platform.com/api/auth/tiktok/callback

# ---- Instagram API with Instagram Login (Meta app "Clicki-IG") ----
IG_APP_ID=1331588402394025
IG_APP_SECRET=
IG_REDIRECT_URI=https://clicki-platform.com/api/auth/instagram/callback
# Базовый публичный URL для data-deletion status (по умолчанию clicki-platform.com)
PUBLIC_BASE_URL=https://clicki-platform.com

# ---- Google Sign-In (test page /google-test) ----
# OAuth 2.0 Web client ID from Google Cloud Console (looks like
# 123456789-abc.apps.googleusercontent.com). The client SECRET is NOT used by
# this flow — do not put it anywhere. Empty = Google sign-in disabled; the test
# page shows setup hints instead of the button.
GOOGLE_CLIENT_ID=
