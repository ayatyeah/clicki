# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ---- Telegram notifications ----
# Create a bot via @BotFather, then put the token + your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email notifications (SMTP, optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLICKI <no-reply@clicki.kz>"
MAIL_TO=

# ---- Anti-spam (optional) ----
# Google reCAPTCHA v3 secret key. Leave empty to disable verification.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ---- Admin panel ----
# Bearer token required to read collected leads via /api/admin/leads
ADMIN_TOKEN=change-me-please
