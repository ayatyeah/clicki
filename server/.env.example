# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:5174

# ---- Telegram notifications ----
# Create a bot via @BotFather, then put the token + your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email notifications (SMTP, optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLICKI <no-reply@clicki.kz>"
MAIL_TO=

# ---- Anti-spam (optional) ----
# Google reCAPTCHA v3 secret key. Leave empty to disable verification.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ---- Admin panel (CMS) ----
# Login for /admin CMS (defaults: admin / admin — change in production!)
ADMIN_USER=admin
ADMIN_PASS=admin
# Bearer token issued on login and required by /api/admin/leads
ADMIN_TOKEN=change-me-please

# ---- Media storage: DigitalOcean Spaces (recommended for video) ----
# When all four are set, uploads go to Spaces (served via its CDN) and the DB
# never stores video bytes. Leave empty to fall back to DB storage.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1
# Optional overrides:
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# SPACES_CDN=https://<bucket>.fra1.cdn.digitaloceanspaces.com

# ---- AI analysis (Gemini) ----
# Up to 3 keys, rotated to spread quota; results cached 6h to save tokens.
# Leave empty to hide the AI Analytics section in /admin.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# ---- TikTok Login Kit + Display API (auto-sync view counts) ----
# From developers.tiktok.com → Manage apps → your app → Login Kit config.
# Leave empty to disable — creators just won't see the "Connect TikTok" button,
# and view counts stay manual (typed in by the operator, as before).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered for the app in the TikTok
# developer portal. Static, https, no query string (their requirement).
TIKTOK_REDIRECT_URI=https://clicki-platform.com/api/auth/tiktok/callback
