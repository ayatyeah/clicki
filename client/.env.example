# Base URL of the backend API. Leave empty to use the dev proxy (/api).
VITE_API_BASE=

# Public contact details (rendered in UI).
VITE_PHONE=+7 700 000 00 00
VITE_TELEGRAM=CLICKI_App
VITE_EMAIL=hello@clicki.kz
# WhatsApp number (digits only, with country code). Defaults to VITE_PHONE.
VITE_WHATSAPP=77000000000

# Optional Google reCAPTCHA v3 site key (must match server RECAPTCHA_SECRET).
VITE_RECAPTCHA_SITE_KEY=

# Analytics (optional — left empty = trackers disabled). Split funnel events
# client_lead / creator_lead fire automatically when an ID is set.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_YANDEX_METRIKA_ID=
