# ═══════════════════════════════════════════════════════════════════════════
#  CLICKI на дроплете — переменные окружения
#
#  Скопируйте в deploy/.env и заполните:   cp .env.example .env && nano .env
#  Файл .env в git НЕ коммитится (см. .gitignore).
#
#  ⚠️ Это окружение КОПИИ сайта на дроплете. Боевой сайт на App Platform
#     настраивается отдельно — в панели DigitalOcean, и этот файл на него
#     никак не влияет.
# ═══════════════════════════════════════════════════════════════════════════

# ---- Локальный Postgres (контейнер db) ----
# Пароль придумайте длинный и случайный:  openssl rand -base64 32
# Это НЕ пароль от боевой managed-базы. Наружу порт 5432 не открыт.
POSTGRES_USER=clicki
POSTGRES_PASSWORD=
POSTGRES_DB=clicki
# Мажорная версия должна быть не ниже, чем у боевой managed-базы, иначе
# pg_dump при переносе откажется читать источник. Скрипт миграции проверит
# это сам и подскажет нужный тег.
POSTGRES_IMAGE=postgres:17-alpine

# ---- Сеть ----
# 0.0.0.0:80 — сайт слушает 80-й порт дроплета напрямую (по умолчанию).
# 127.0.0.1:8080 — если включаете HTTPS через профиль tls (тогда наружу Caddy).
APP_BIND=0.0.0.0:80
# Домен для профиля tls. Нужен, только если поднимаете HTTPS.
DOMAIN=
TZ=Asia/Almaty

# ---- Бэкапы ----
# Формат обычного crontab. По умолчанию каждый день в 03:30 по TZ выше.
BACKUP_CRON=30 3 * * *
# Сколько дней хранить ежедневные копии. Дампы, снятые 1-го числа, живут
# MONTHLY_RETENTION_DAYS — так получается годовая история почти бесплатно.
RETENTION_DAYS=14
MONTHLY_RETENTION_DAYS=365
# Файлы из таблицы media размером до N МБ попадают в бэкап (аватары, логотипы,
# скриншоты статистики). ВИДЕО НЕ БЭКАПИТСЯ НИКОГДА — оно весит до 150 МБ на
# файл и должно жить в Spaces, а не в дампе. 0 = не сохранять media совсем.
BACKUP_MEDIA_MAX_MB=5
# Сделать первый бэкап сразу при старте контейнера, не дожидаясь ночи.
BACKUP_ON_START=1
# 1 = писать в телеграм и об УСПЕШНЫХ бэкапах тоже (об ошибках пишет всегда).
NOTIFY_ON_SUCCESS=0

# ---- Фронтенд: вшивается в бандл при СБОРКЕ образа ----
# После изменения любой VITE_* нужна пересборка: docker compose up -d --build
VITE_API_BASE=
VITE_PHONE=+7 700 000 00 00
VITE_TELEGRAM=CLICKI_App
VITE_EMAIL=info@clicki-platform.com
VITE_WHATSAPP=
VITE_RECAPTCHA_SITE_KEY=
# Аналитика. На КОПИИ сайта их лучше оставить пустыми, иначе тестовые заходы
# смешаются со статистикой боевого домена.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_YANDEX_METRIKA_ID=

# ---- Бэкенд ----
# Домены, с которых разрешены запросы к API. Укажите то, по какому адресу
# реально открываете копию: http://<IP-дроплета> или https://<DOMAIN>.
CORS_ORIGINS=http://localhost:5174
# Публичный базовый URL — используется в ссылках, которые генерирует сервер.
PUBLIC_BASE_URL=

# Админка. НЕ переиспользуйте боевые логин/пароль: копия обычно доступна по
# голому IP без HTTPS, и пароль уйдёт по сети открытым текстом.
ADMIN_USER=admin
ADMIN_PASS=
ADMIN_TOKEN=

# enforce | report-only | off
CSP_MODE=enforce

# ---- Уведомления (необязательно) ----
# Тот же бот используется скриптом бэкапа для алертов о падении.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECAPTCHA_SECRET=

# ---- Хранилище медиа (DigitalOcean Spaces) ----
# Если заполнить — новые видео на дроплете пойдут в Spaces, а не в Postgres.
# Это правильный путь: именно поэтому видео и не нужно бэкапить из БД.
# ⚠️ Указывайте ОТДЕЛЬНЫЙ бакет или префикс, иначе тестовые загрузки с копии
#    попадут в тот же бакет, что и боевые.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1
SPACES_ENDPOINT=
# Куда внутри бакета класть дампы БД, если включена выгрузка копий наружу.
SPACES_BACKUP_PREFIX=db-backups

# ---- Внешние интеграции ----
# ⚠️ ВАЖНО ПРО OAUTH. Redirect URI у TikTok, Instagram и Google жёстко
#    зарегистрированы на https://clicki-platform.com. На копии, открытой по
#    IP дроплета, эти три сценария входа работать НЕ БУДУТ — провайдер
#    вернёт redirect_uri_mismatch. Это ожидаемо и не является поломкой
#    переноса; подробности и способ обхода — в deploy/README.md.
#    Оставьте пустыми, чтобы функции просто не показывались в интерфейсе.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
GOOGLE_CLIENT_ID=

# ---- Служебное ----
# Подставляется автоматически скриптом deploy.sh; вручную трогать не нужно.
GIT_COMMIT=
