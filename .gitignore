# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
build/
client/dist/
*.tsbuildinfo

# ---- Environment variables (keep the *.example templates) ----
.env
.env.*
!.env.example
!client/.env.example
!server/.env.example

# ---- Runtime data / collected leads / uploaded media ----
server/data/
server/uploads/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- Caches ----
.vite/
.cache/
.npm/
.eslintcache
coverage/
*.local

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Playwright MCP (browser screenshots / snapshots) ----
# .playwright-mcp/ is where QA screenshots/snapshots/console-logs are meant to
# land (see .claude/agents/ui-visual-qa.md). The three root-level globs below
# are a safety net, not dead weight: as of 2026-07-28, a QA run still dropped
# admin-creators.png straight into the repo root, and this /admin-*.png rule
# is the only reason it didn't show up as untracked clutter. Don't remove
# these without re-checking that nothing still writes screenshots to root.
.playwright-mcp/
/admin-*.png
/creator-*.png
/page-*.png
.mcp.json
